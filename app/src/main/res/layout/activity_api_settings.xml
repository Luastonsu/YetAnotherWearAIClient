<?xml version="1.0" encoding="utf-8"?>
<com.yawac.client.ui.SwipeBackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsSwipe" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.yawac.client.ui.RoundSafeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="30dp" android:paddingEnd="30dp"
                android:paddingTop="36dp" android:paddingBottom="48dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/api_settings" android:gravity="center" android:textStyle="bold"
                    android:textSize="17sp" android:textColor="@color/text_primary" />
                <Button android:id="@+id/phoneSetup" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="10dp" android:text="@string/phone_setup"
                    android:textSize="13sp" android:textColor="@color/white" />
                <Button android:id="@+id/deepSeekPreset" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="10dp" android:text="DeepSeek 预设" android:textSize="14sp" android:textColor="@color/white" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="API URL（HTTPS）" android:labelFor="@id/apiUrl" android:textSize="12sp" android:textColor="@color/text_primary" />
                <EditText android:id="@+id/apiUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:inputType="textUri" android:imeOptions="actionNext" android:saveEnabled="false"
                    android:importantForAutofill="no" android:textSize="12sp" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="API Key" android:labelFor="@id/apiKey" android:textSize="12sp" android:textColor="@color/text_primary" />
                <EditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:inputType="textPassword" android:imeOptions="actionNext|flagNoPersonalizedLearning"
                    android:saveEnabled="false" android:importantForAutofill="no" android:textSize="12sp" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="模型 ID" android:labelFor="@id/apiModel" android:textSize="12sp" android:textColor="@color/text_primary" />
                <AutoCompleteTextView android:id="@+id/apiModel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:inputType="textVisiblePassword" android:singleLine="true" android:imeOptions="actionDone"
                    android:saveEnabled="false" android:importantForAutofill="no" android:textSize="12sp" android:textColor="@color/text_primary" />
                <Button android:id="@+id/chooseModel" android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="DeepSeek 模型列表" android:textSize="14sp" android:textColor="@color/white" />
                <TextView android:id="@+id/apiStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite" android:layout_marginTop="8dp" android:text="@string/api_config_help"
                    android:textSize="11sp" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/saveApiConfig" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:text="保存" android:textSize="14sp" android:textColor="@color/white" />
                <Button android:id="@+id/clearApiConfig" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:text="清除 API 配置" android:textSize="14sp" android:textColor="@color/white" />
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/view_clock" />
    </com.yawac.client.ui.RoundSafeLayout>
</com.yawac.client.ui.SwipeBackLayout>
