<?xml version="1.0" encoding="utf-8"?>
<com.yawac.client.ui.SwipeBackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsSwipe" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.yawac.client.ui.RoundSafeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="32dp" android:paddingBottom="40dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:text="@string/chat_appearance_settings" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:id="@+id/chatFontValue" style="@style/SettingsNote" android:gravity="center" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/chatFontSmaller" style="@style/SettingsRow" android:layout_width="0dp" android:layout_weight="1"
                        android:text="A−" android:contentDescription="减小聊天字号" />
                    <TextView android:id="@+id/chatFontLarger" style="@style/SettingsRow" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="A＋" android:contentDescription="增大聊天字号" />
                </LinearLayout>
                <TextView android:id="@+id/userBubbleColor" style="@style/SettingsRow" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/aiBubbleColor" style="@style/SettingsRow" android:layout_marginTop="6dp" />
                <TextView style="@style/SettingsNote" android:text="点击切换配色，自动保存。仅影响聊天页面，阅读页字号保持独立。" />
                <TextView android:id="@+id/previewUserBubble" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end" android:layout_marginTop="12dp" android:padding="11dp" android:text="这是我的消息" />
                <TextView android:id="@+id/previewAiBubble" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:padding="11dp" android:text="这是 AI 回复预览。" />
                <TextView android:id="@+id/resetChatAppearance" style="@style/SettingsRow" android:layout_marginTop="12dp" android:text="恢复默认外观" />
                <TextView style="@style/SettingsNote" android:text="@string/misans_credit" android:textSize="10sp" />
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/view_clock" />
    </com.yawac.client.ui.RoundSafeLayout>
</com.yawac.client.ui.SwipeBackLayout>
