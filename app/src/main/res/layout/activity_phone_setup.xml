<?xml version="1.0" encoding="utf-8"?>
<com.yawac.client.ui.SwipeBackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsSwipe" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.yawac.client.ui.RoundSafeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingTop="30dp" android:paddingBottom="36dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:text="@string/phone_setup_title"
                    android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <FrameLayout android:id="@+id/qrCard" android:layout_width="170dp" android:layout_height="170dp"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"
                    android:background="@android:color/white" android:padding="8dp" android:visibility="gone">
                    <ImageView android:id="@+id/setupQr" android:layout_width="154dp" android:layout_height="154dp"
                        android:layout_gravity="center" android:background="@android:color/white"
                        android:contentDescription="手机配置二维码" android:scaleType="fitCenter" />
                </FrameLayout>
                <TextView android:id="@+id/setupStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center"
                    android:textColor="@color/text_primary" android:textSize="11sp" />
                <TextView android:id="@+id/setupUrl" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center"
                    android:breakStrategy="simple" android:lineSpacingExtra="1dp" android:textColor="@color/text_secondary"
                    android:textIsSelectable="true" android:textSize="9sp" android:visibility="gone" />
                <TextView android:id="@+id/phoneSetupHelp" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp" android:text="@string/phone_setup_help"
                    android:textColor="@color/text_secondary" android:textSize="10sp" />
                <Button android:id="@+id/openWifiSettings" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="10dp" android:text="@string/open_watch_wifi"
                    android:textColor="@color/white" android:textSize="13sp" />
                <Button android:id="@+id/retrySetup" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="6dp" android:text="@string/retry_detect"
                    android:textColor="@color/white" android:textSize="13sp" />
                <Button android:id="@+id/manualSetup" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="6dp" android:text="@string/manual_input"
                    android:textColor="@color/white" android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/view_clock" />
    </com.yawac.client.ui.RoundSafeLayout>
</com.yawac.client.ui.SwipeBackLayout>
